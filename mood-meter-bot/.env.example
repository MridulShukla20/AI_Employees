# Copy to .env and fill in real values. NEVER commit the real .env.
# Pass to the container with:  docker run --env-file .env ...

# --- MySQL ---
# 127.0.0.1 = use the database embedded in the container (recommended).
# Point at another host/container to use an external MySQL instead.
DB_HOST=127.0.0.1
DB_USER=moodbot
DB_PASSWORD=change-me
DB_NAME=mood_tracker_db

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-bot-token

# --- Keka HR API ---
KEKA_API_KEY=your-keka-api-key
KEKA_CLIENT_ID=your-keka-client-id
KEKA_CLIENT_SECRET=your-keka-client-secret
KEKA_SUBDOMAIN=https://yourcompany.keka.com/api/v1/hris/employees

# --- Optional ---
# Scheduler windows (noon-10pm delivery, Sunday pause) follow this timezone
#TZ=Asia/Kolkata
